<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">

    <!-- Declared on the interface: every resolver in every module, without naming any of them. -->
    <type name="Magento\Framework\GraphQl\Query\ResolverInterface">
        <plugin name="magepsycho_profiler_graphql_resolver" type="MagePsycho\Profiler\Plugin\GraphQl\ResolverProfiler" sortOrder="10"/>
    </type>

    <type name="Magento\Framework\GraphQl\Query\QueryProcessor">
        <plugin name="magepsycho_profiler_graphql_query" type="MagePsycho\Profiler\Plugin\GraphQl\QueryProcessorProfiler" sortOrder="10"/>
    </type>

</config>

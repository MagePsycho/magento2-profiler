#
# Static analysis config for MagePsycho_Profiler.
#
# Run from the Magento root:
#   vendor/bin/phpstan analyse -c app/code/MagePsycho/Profiler/phpstan.neon --memory-limit=1G
#
parameters:
    level: 8
    paths:
        - .
    bootstrapFiles:
        - ../../../../vendor/autoload.php
    treatPhpDocTypesAsCertain: false
    excludePaths:
        analyse:
            # PHPStan reads phpredis from bundled stubs older than the extension actually installed:
            # they declare mget() returning `Redis|array` where phpredis 6.3 returns
            # `Redis|array|false`. Matching the real extension is mandatory - narrowing the return type
            # would turn a soft `false` on a lost connection into a TypeError - and PHP itself accepts
            # the class, which it would refuse outright on a real covariance violation. PHPStan marks
            # signature errors as unignorable, so the file has to be excluded rather than silenced.
            # Nothing is lost: every method here is a one-line delegation to parent::, and the logic
            # that decides anything lives in ProfiledRedisInstaller, which is still analysed.
            - Model/Cache/ProfiledRedis.php
    ignoreErrors:
        # BP is defined by app/autoload.php at runtime, which is not part of the analysed set.
        # Every use of it in this module is already guarded by defined('BP').
        - '#Constant BP not found#'

        # Upstream docblock bug: Magento\Framework\Profiler\Driver\Standard\Stat::start()/stop()
        # document "@param int $time", but Magento's own driver passes microtime(true) - a float -
        # at vendor/magento/framework/Profiler/Driver/Standard/Standard.php:169,180. The tests feed
        # the same float values the real driver does.
        -
            message: '#\$time of method Magento\\Framework\\Profiler\\Driver\\Standard\\Stat::(start|stop)\(\) expects int, float given#'
            path: Test/Unit/Model/Profiler/Output/TabularTest.php

        # The installer is deliberately defensive about what it is handed: it is called with whatever
        # the cache frontend exposes, so the non-object case is a real branch and worth a test.
        -
            message: '#Parameter \#1 \$backend of method MagePsycho\\Profiler\\Model\\Cache\\ProfiledRedisInstaller::install\(\) expects object, string given#'
            path: Test/Unit/Model/Cache/ProfiledRedisInstallerTest.php

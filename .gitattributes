# Keep the dist archive (and therefore vendor/magepsycho/magento2-profiler) to runtime files only.
# Everything below is stripped from `git archive`, GitHub zipballs and `composer install --prefer-dist`.

/docs                   export-ignore
/tests                  export-ignore
/dist                   export-ignore
/.github                export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.php-cs-fixer.dist.php export-ignore
/phpstan.neon           export-ignore
/phpstan.neon.dist      export-ignore
/phpunit.xml.dist       export-ignore

# The dev configs actually live at the module root, which is src/ in this repo. The entries
# above are repo-root paths kept for the layout the archive script assumes; these are the
# ones that match.
/src/phpcs.xml.dist     export-ignore
/src/phpstan.neon       export-ignore
/src/phpunit.xml.dist   export-ignore
